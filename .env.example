# Másold le .env néven:  cp .env.example .env   majd szerkeszd:  nano .env

# AI API-kulcs – CSAK az egyiket töltsd ki (amelyik szolgáltatótól van)
OPENAI_API_KEY=
STABILITY_API_KEY=

# Domain (pl. kepek.pelda.hu) -> automatikus HTTPS.
# Ha nincs domained, hagyd üresen: az oldal a szerver IP címén, http-n lesz elérhető.
SITE_ADDRESS=

# Napi képkorlát felhasználónként
DAILY_LIMIT=20

# AI-videó (OpenAI Sora) – csak OpenAI kulccsal működik
AI_VIDEO_DAILY_LIMIT=3
SORA_MODEL=sora-2

# Otthoni gép (saját modell a videókártyádon) – lásd Otthoni_gep_utmutato.pdf
# Token előállítása:  openssl rand -hex 24
WORKER_TOKEN=
# local = az otthoni gép generál (ha WORKER_TOKEN be van állítva, ez az alapértelmezés)
IMAGE_PROVIDER=
# Meddig várjon a weboldal egy képre az otthoni gépen (másodperc)
LOCAL_TIMEOUT=600
